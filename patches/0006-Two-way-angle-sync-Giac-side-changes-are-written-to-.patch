From 5b0305f801fcbd7b3b247b89185175a793235021 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Thu, 24 Sep 2026 19:51:53 +0100
Subject: [PATCH 06/21] Two-way angle sync: Giac-side changes are written to
 the OS byte (zskin_angle_step)

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 console.cc | 25 +++++++++++++++++++------
 1 file changed, 19 insertions(+), 6 deletions(-)

diff --git a/console.cc b/console.cc
index 7709bf2..6c9d375 100644
--- a/console.cc
+++ b/console.cc
@@ -2,6 +2,7 @@
 #include <fxcg/display.h>
 #include "zskin_status.h"
 #include "zskin_os.h"
+#include "zskin_angle.h"
 #include "zskin_tabs.h"
 #include <fxcg/file.h>
 #include <fxcg/keyboard.h>
@@ -73,15 +74,27 @@ int printmsg12(const char * msg1,const char * msg2){
   return r;
 }
 
-// OS setup bytes are authoritative for the angle unit (docs/superpowers/specs, section 3.1)
+// Two-way angle sync (decision logic in zskin_angle.c, unit-tested on the host):
+// OS SETUP changes apply to Giac, Giac-side changes are written to the OS byte.
 void zskin_sync_modes(){
-  unsigned char a=GetSetupSetting(ZOS_BYTE_ANGLE);
-  if (a!=ZOS_ANGLE_RAD && a!=ZOS_ANGLE_DEG)
-    return; // e.g. grad: KhiCAS has no grad mode, leave the Giac setting alone
-  bool rad=(a==ZOS_ANGLE_RAD);
-  if (giac::angle_radian(contextptr)!=rad){
+  static zskin_angle_state st=ZSKIN_ANGLE_STATE_INIT;
+  int action=zskin_angle_step(&st,GetSetupSetting(ZOS_BYTE_ANGLE),giac::angle_radian(contextptr)?1:0);
+  switch (action){
+  case ZSKIN_ANGLE_SET_GIAC_RAD:
+  case ZSKIN_ANGLE_SET_GIAC_DEG: {
+    bool rad=(action==ZSKIN_ANGLE_SET_GIAC_RAD);
     giac::angle_radian(rad,giac::context0);
     giac::angle_radian(rad,contextptr);
+    break;
+  }
+  case ZSKIN_ANGLE_WRITE_OS_RAD:
+    SetSetupSetting(ZOS_BYTE_ANGLE,ZOS_ANGLE_RAD);
+    break;
+  case ZSKIN_ANGLE_WRITE_OS_DEG:
+    SetSetupSetting(ZOS_BYTE_ANGLE,ZOS_ANGLE_DEG);
+    break;
+  default:
+    break;
   }
 }
 
