Subject: [PATCH 02/22] Shell/editor tab bar with native geometry via gfx/skin

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 console.cc | 5 ++++-
 main.cc    | 5 ++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/console.cc b/console.cc
index 5437249..bc74b8b 100644
--- a/console.cc
+++ b/console.cc
@@ -1,6 +1,7 @@
 #include "giacPCH.h"
 #include <fxcg/display.h>
 #include "zskin_status.h"
+#include "zskin_tabs.h"
 #include <fxcg/file.h>
 #include <fxcg/keyboard.h>
 #include <fxcg/system.h>
@@ -3310,7 +3311,9 @@ void console_disp_status(){
   string menu(" "),shiftmenu=menu,alphamenu; int menucolorbg=12345;
   get_current_console_menu(menu,shiftmenu,alphamenu,menucolorbg,0);
   int px=0*3,py=58*3;
-  PrintMini(&px,&py,(unsigned char *)menu.c_str(),0,0xFFFFFFFF,0,0,COLOR_BLACK,menucolorbg, 1, 0);
+  char labels[SKIN_TABS][SKIN_TAB_LABEL_MAX];
+  skin_tabs_split(menu.c_str(),labels);
+  skin_tabs_draw(labels);
   // status, clock, 
   set_xcas_status();
   Bdisp_PutDisp_DD();
diff --git a/main.cc b/main.cc
index a608efb..89159e5 100644
--- a/main.cc
+++ b/main.cc
@@ -5,6 +5,7 @@
 #include "giacPCH.h"
 #include <fxcg/display.h>
 #include "zskin_status.h"
+#include "zskin_tabs.h"
 #include <fxcg/file.h>
 #include <fxcg/keyboard.h>
 #include <fxcg/system.h>
@@ -746,7 +747,9 @@ void casiostatus(const char * menu,const char * shiftmenu,const char * alphamenu
     }
     if (cur!=prev){
       prev=cur;
-      PrintMini(&px,&py,(unsigned char *)cur,0,0xFFFFFFFF,0,0,COLOR_BLACK,color, 1, 0);
+      char labels[SKIN_TABS][SKIN_TAB_LABEL_MAX];
+      skin_tabs_split(cur,labels);
+      skin_tabs_draw(labels);
     }
   }
 }
