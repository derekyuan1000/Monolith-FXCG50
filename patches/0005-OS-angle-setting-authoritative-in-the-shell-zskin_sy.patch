From f2590b98bc3e7d2b3b2e3b9777bc7108fad2c793 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Thu, 24 Sep 2026 19:38:24 +0100
Subject: [PATCH 05/22] OS angle setting authoritative in the shell
 (zskin_sync_modes); SETUP toggle writes OS byte

---
 console.cc | 15 +++++++++++++++
 console.h  |  1 +
 2 files changed, 16 insertions(+)

diff --git a/console.cc b/console.cc
index f334046..7709bf2 100644
--- a/console.cc
+++ b/console.cc
@@ -1,6 +1,7 @@
 #include "giacPCH.h"
 #include <fxcg/display.h>
 #include "zskin_status.h"
+#include "zskin_os.h"
 #include "zskin_tabs.h"
 #include <fxcg/file.h>
 #include <fxcg/keyboard.h>
@@ -72,7 +73,20 @@ int printmsg12(const char * msg1,const char * msg2){
   return r;
 }
 
+// OS setup bytes are authoritative for the angle unit (docs/superpowers/specs, section 3.1)
+void zskin_sync_modes(){
+  unsigned char a=GetSetupSetting(ZOS_BYTE_ANGLE);
+  if (a!=ZOS_ANGLE_RAD && a!=ZOS_ANGLE_DEG)
+    return; // e.g. grad: KhiCAS has no grad mode, leave the Giac setting alone
+  bool rad=(a==ZOS_ANGLE_RAD);
+  if (giac::angle_radian(contextptr)!=rad){
+    giac::angle_radian(rad,giac::context0);
+    giac::angle_radian(rad,contextptr);
+  }
+}
+
 void set_xcas_status(){
+  zskin_sync_modes();
   zskin_status_icons();
   DisplayStatusArea();
 }
@@ -203,6 +217,7 @@ void menu_setup(){
       if (smallmenu.selection == 3){
         giac::angle_radian(!giac::angle_radian(contextptr),giac::context0);
         giac::angle_radian(!giac::angle_radian(contextptr),contextptr);
+        SetSetupSetting(ZOS_BYTE_ANGLE,giac::angle_radian(contextptr)?ZOS_ANGLE_RAD:ZOS_ANGLE_DEG);
         continue;
       }
       if (smallmenu.selection == 4){
diff --git a/console.h b/console.h
index 70b9581..5f55ee2 100644
--- a/console.h
+++ b/console.h
@@ -149,6 +149,7 @@ const char * paste_clipboard();
 const char * input_matrix(bool list);
 extern char xcas_status[64];
 void set_xcas_status();
+void zskin_sync_modes();
 
 extern int xthetat;
 const char * keytostring(int key,int keyflag); // key to char *, 0 if not handled
