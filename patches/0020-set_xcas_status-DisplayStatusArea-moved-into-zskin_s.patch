Subject: [PATCH 20/25] set_xcas_status: DisplayStatusArea moved into
 zskin_status_runmat

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 console.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/console.cc b/console.cc
index e5f087b..655f08e 100644
--- a/console.cc
+++ b/console.cc
@@ -117,8 +117,9 @@ void zskin_sync_modes(){
 
 void set_xcas_status(){
   zskin_sync_modes();
+  /* DisplayStatusArea() is called inside zskin_status_runmat so box borders
+   * can be drawn on top of the OS-rendered text in the same pass. */
   zskin_status_runmat(giac::angle_radian(contextptr));
-  DisplayStatusArea();
 }
 
 void menu_setup(){
