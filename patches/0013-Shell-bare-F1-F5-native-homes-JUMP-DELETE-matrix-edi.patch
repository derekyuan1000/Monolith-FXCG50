From 79652187aca7e01d15f08bc109e36e139104f5a2 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Sun, 27 Sep 2026 15:02:23 +0100
Subject: [PATCH 13/23] Shell: bare F1-F5 native homes
 (JUMP/DELETE/matrix-editor/MATH-first/CAS sub-bar), right-aligned results,
 history scrollbar (M2 task 7)

---
 console.cc | 81 ++++++++++++++++++++++++++++++++++++++++++------------
 1 file changed, 63 insertions(+), 18 deletions(-)

diff --git a/console.cc b/console.cc
index f4e7436..a11aaab 100644
--- a/console.cc
+++ b/console.cc
@@ -6,6 +6,8 @@
 #include "zskin_tabs.h"
 #include "znat.h"
 #include "zstack.h"
+#include "theme.h"
+#include "zskin_scroll.h"
 #include <fxcg/file.h>
 #include <fxcg/keyboard.h>
 #include <fxcg/system.h>
@@ -51,6 +53,10 @@ int khicas_addins_menu(GIAC_CONTEXT);
 // Monolith (M2 task 6): S<->D result-form pop-up (skin/zsd_ui.cc); declared the same way as the
 // add-ins menu above, for the same reason (a one-line hook, no shared struct/constant).
 int zsd_open(GIAC_CONTEXT);
+// Monolith (M2 task 7): bare-shell F-key homes (skin/zshellbar.cc), same declare-only convention.
+int zjump_open(void);
+int zdelete_open(void);
+int zcas_open(int menucolorbg);
 
 giac::context * contextptr=0;
 int xthetat=0,xcas_python_eval=0;
@@ -2431,9 +2437,11 @@ int Console_GetKey(){
     // if (key==30006) OS_InnerWait_ms(1000); // key='6';
     if (key!=KEY_CHAR_FRAC) translate_fkey(key);
     if (key==KEY_CTRL_F5){
-      handle_f5();
-      Console_Disp();
-      continue;
+      // Monolith (M2 task 7): F5 CAS sub-bar (docs/KEY_CONFLICTS.md section 2) -- "the pull up KhiCAS
+      // functions button": exactly today's default bottom bar (menu_f1/menu_f2/menu_f3/CMDS/A<>a), now one
+      // level down since F1/F2/F3 have native meanings at the top level; shift-/alpha- inside it keep
+      // reaching menu_f7..f18 (FMENU.py) unchanged. skin/zshellbar.cc zcas_open.
+      return zcas_open(menucolorbg);
     }
     if (key==KEY_CTRL_SD || key==KEY_CTRL_FD){
       // Monolith (M2 task 6): S<->D opens a native-list-style pop-up to choose the form of the last result
@@ -2550,6 +2558,21 @@ int Console_GetKey(){
       continue;
     }
     if (key==KEY_CTRL_F4){
+      // Monolith (M2 task 7): F4 MATH now offers Task 5's natural-input template sub-bar directly on the
+      // bare shell line (docs/KEY_CONFLICTS.md section 2, the gap that task flagged as "not yet wired on
+      // the bare shell line"), same guard every template key already uses (Current_Line==Last_Line: the
+      // line being edited; !readonly; !alph: alpha-F4 keeps the plain catalog below, matching how alpha
+      // never opens the natural editor for the physical template keys either). ZNAT_TPL_NONE (EXIT with no
+      // pick) or ZNAT_NOT_HANDLED (the template did not fit, or the line does not fit the nin/ model) falls
+      // through to the catalog exactly as F4 always behaved, unchanged.
+      if (!alph && Current_Line==Last_Line && !Line[Current_Line].readonly){
+	int mk=znat_math_submenu(menucolorbg);
+	if (mk!=ZNAT_TPL_NONE){
+	  int znr=znat_edit_template(mk);
+	  if (znr!=ZNAT_NOT_HANDLED)
+	    return znr;
+	}
+      }
       char buf[512];
       if (!showCatalog(buf,0,0))
 	buf[0]=0;
@@ -2754,6 +2777,28 @@ int Console_GetKey(){
       return CONSOLE_SUCCEEDED;
 #endif
     }
+    if (key==KEY_CTRL_F1){
+      // Monolith (M2 task 7): F1 JUMP (docs/KEY_CONFLICTS.md section 2), replacing the old menu_f1 fast
+      // menu here (moved into the new F5 CAS sub-bar below, unchanged). skin/zshellbar.cc zjump_open.
+      return zjump_open();
+    }
+    if (key==KEY_CTRL_F2){
+      // Monolith (M2 task 7): F2 DELETE (DEL-LINE / DEL-ALL), replacing the old menu_f2 fast menu here
+      // (moved into the CAS sub-bar). skin/zshellbar.cc zdelete_open.
+      return zdelete_open();
+    }
+    if (key==KEY_CTRL_F3){
+      // Monolith (M2 task 7): F3 opens the existing KhiCAS matrix editor directly (the same call the F6
+      // Applications menu's own "Matrix editor" entry makes below), replacing the old menu_f3 fast menu
+      // here (moved into the CAS sub-bar).
+      drawRectangle(0, 0, LCD_WIDTH_PX, LCD_HEIGHT_PX-8, COLOR_WHITE);
+      {
+	const char * mptr=input_matrix(false);
+	if (mptr) return Console_Input((const unsigned char *)mptr);
+      }
+      Console_Disp();
+      continue;
+    }
     if ( (key >= KEY_CTRL_F1 && key <= KEY_CTRL_F6) 
 	 || (key >= KEY_CTRL_F7 && key <= KEY_CTRL_F20) 
 	 ){
@@ -3351,18 +3396,14 @@ void get_current_console_menu(string & menu,string & shiftmenu,string & alphamen
     menu=lang==1?" tests | struct | misc | cmds | A<>a |Fich. ":" tests | loops | misc | cmds | A<>a |File ";
   }
   else {
-    menu += string(menu_f1);
-    while (menu.size()<6)
-      menu += " ";
-    menu += "| ";
-    menu += string(menu_f2);
-    while (menu.size()<13)
-      menu += " ";
-    menu += "| ";
-    menu += string(menu_f3);
-    while (menu.size()<20)
-      menu += " ";
-    menu += lang?"| cmds | A<>a | Fich.  ":" | cmds  | A<>a | File   ";
+    // Monolith (M2 task 7): bare shell native F-key homes (docs/KEY_CONFLICTS.md section 2). The old
+    // default (menu_f1/menu_f2/menu_f3/cmds/A<>a/File) moved into the new F5 CAS sub-bar
+    // (skin/zshellbar.cc zcas_open), reachable unchanged; FMENU.py's menu_f7..f18 keep working via
+    // shiftmenu/alphamenu below (unchanged, computed the same way regardless of app) and via zcas_open's
+    // own KEY_CTRL_F7..F20 forwarding to Console_FMenu. Same English labels regardless of lang: these are
+    // RUN-MAT's own fixed key legends (ref/TOPBAR.txt), and no French wording for them is documented
+    // anywhere in this repo, so none is invented here.
+    menu = "JUMP|DEL|MAT|MATH|CAS|File";
   }
   //drawRectangle(0,174,LCD_WIDTH_PX,24,COLOR_BLACK);
   int xcas_color=python_compat(contextptr)==0?65055:COLOR_CYAN,python_color=65520,js_color=63048;
@@ -3424,6 +3465,7 @@ int Console_Disp(){
       }
       else {
 	zlocate(COL_DISP_MAX - curline.disp_len + 1, zly[i]);
+	print_x -= (LCD_WIDTH_PX - 1 - RM_RESULT_RIGHT_X);  // Monolith M2 task 7: leave the scrollbar gutter free
 	if (curline.readonly){
 #ifdef CURSOR
 	  Cursor_SetFlashOff();
@@ -3439,7 +3481,7 @@ int Console_Disp(){
 	locate(COL_DISP_MAX, i + 1);
 #else
 	print_y=zly[i];
-	print_x=LCD_WIDTH_PX-hfontsize;
+	print_x=LCD_WIDTH_PX-hfontsize-(LCD_WIDTH_PX - 1 - RM_RESULT_RIGHT_X);  // Monolith M2 task 7
 #endif
 	if (curline.readonly){
 	  if(curline.disp_len - curline.start_col != COL_DISP_MAX) {
@@ -3570,7 +3612,7 @@ int Console_Disp(){
 	locate(COL_DISP_MAX - Line[i + Start_Line].disp_len + 1, i + 1);
 #else
 	print(print_x,print_y,(const char *)curline.str,TEXT_COLOR_BLACK,false,true/*fake*/,false);
-	print_x=LCD_WIDTH_PX-print_x;
+	print_x=LCD_WIDTH_PX-print_x-(LCD_WIDTH_PX - 1 - RM_RESULT_RIGHT_X);  // Monolith M2 task 7
 #endif
 	Print(curline.str,TEXT_COLOR_BLACK,colorsyntax);
       }
@@ -3578,7 +3620,7 @@ int Console_Disp(){
 #ifdef CURSOR
 	locate(COL_DISP_MAX, i + 1);
 #else
-	print_x=LCD_WIDTH_PX-hfontsize;
+	print_x=LCD_WIDTH_PX-hfontsize-(LCD_WIDTH_PX - 1 - RM_RESULT_RIGHT_X);  // Monolith M2 task 7
 #endif
 	Print((unsigned char *)"\xE6\x9B",COLOR_BLUE,colorsyntax);
       }
@@ -3593,6 +3635,9 @@ int Console_Disp(){
     } // end non cursor line
   } // end loop on all lines
 
+  // Monolith (M2 task 7): history scrollbar (docs/RUNMAT_SPEC.md "Scrollbar" row; skin/zskin_scroll.c).
+  zskin_scroll_draw(Last_Line+1, LINE_DISP_MAX, Start_Line, RM_STATUS_AREA_PX, LINE_DISP_MAX*vfontsize);
+
   console_disp_status();
   return CONSOLE_SUCCEEDED;
 }
