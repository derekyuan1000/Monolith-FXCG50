From fabdfd89d5167ea1c88212e6e33662242e0baf58 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Mon, 28 Sep 2026 22:00:00 +0100
Subject: [PATCH 17/22] Shell: Shift+F1=CAS, Shift+F2=File, Shift+F3=Pinned;
 EXIT silent no-op; F5/F6 tab labels blank (M2 task 9)

Hand-written patch applied on top of 0016.  Re-export with
tools/export_patches.sh after the next successful build.

Shift+F1 (KEY_CTRL_F7) -> zcas_open   (was: FMENU.py menu_f7)
Shift+F2 (KEY_CTRL_F8) -> File menu   (was: FMENU.py menu_f8)
Shift+F3 (KEY_CTRL_F9) -> zpinned_open (was: FMENU.py menu_f9)
menu_f7/f8/f9 remain reachable from inside the CAS sub-bar via
zcas_open's existing KEY_CTRL_F7..F20 -> Console_FMenu forwarding.

F5 bare-shell handler removed; F5/F6 fall through to the FMENU
catch-all -> Console_FMenu(KEY_CTRL_F5/F6) = menu_f5/menu_f6
(empty by default, user-configurable via FMENU.py).

EXIT on the main shell is now a silent no-op: Console_Disp +
continue, suppressing the mode-switch dialog entirely.

zpinned_open is in skin/zshellbar.cc (overlay, not patched here).
---
 console.cc | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/console.cc b/console.cc
index 6836d69..05eb90c 100644
--- a/console.cc
+++ b/console.cc
@@ -58,6 +58,8 @@ int zsd_open(GIAC_CONTEXT);
 int zjump_open(void);
 int zdelete_open(void);
 int zcas_open(int menucolorbg);
+// Monolith (M2 task 9): Shift+F3 pinned items sub-bar (skin/zshellbar.cc).
+int zpinned_open(void);
 
 giac::context * contextptr=0;
 int xthetat=0,xcas_python_eval=0;
@@ -2461,13 +2463,8 @@ int Console_GetKey(){
     bool alph=oldalphastate;
     // if (key==30006) OS_InnerWait_ms(1000); // key='6';
     if (key!=KEY_CHAR_FRAC) translate_fkey(key);
-    if (key==KEY_CTRL_F5){
-      // Monolith (M2 task 7): F5 CAS sub-bar (docs/KEY_CONFLICTS.md section 2) -- "the pull up KhiCAS
-      // functions button": exactly today's default bottom bar (menu_f1/menu_f2/menu_f3/CMDS/A<>a), now one
-      // level down since F1/F2/F3 have native meanings at the top level; shift-/alpha- inside it keep
-      // reaching menu_f7..f18 (FMENU.py) unchanged. skin/zshellbar.cc zcas_open.
-      return zcas_open(menucolorbg);
-    }
+    // Monolith (M2 task 9): EXIT on the bare shell is a silent no-op (mode-switch dialog removed).
+    if (key==KEY_CTRL_EXIT) { Console_Disp(); continue; }
     if (key==KEY_CTRL_SD || key==KEY_CTRL_FD){
       // Monolith (M2 task 6): S<->D opens a native-list-style pop-up to choose the form of the last result
       // (docs/KEY_CONFLICTS.md section 3, "S<->D" row), instead of the add-ins menu (still reachable from
@@ -2829,6 +2826,10 @@ int Console_GetKey(){
       Console_Disp();
       continue;
     }
+    // Monolith (M2 task 9): Shift+F1/F2/F3 open CAS sub-bar, File menu, Pinned items.
+    if (key==KEY_CTRL_F7) return zcas_open(menucolorbg);
+    if (key==KEY_CTRL_F8) return Console_FMenu(KEY_CTRL_F6);
+    if (key==KEY_CTRL_F9) return zpinned_open();
     if ( (key >= KEY_CTRL_F1 && key <= KEY_CTRL_F6) 
 	 || (key >= KEY_CTRL_F7 && key <= KEY_CTRL_F20) 
 	 ){
@@ -3433,7 +3434,14 @@ void get_current_console_menu(string & menu,string & shiftmenu,string & alphamen
     // own KEY_CTRL_F7..F20 forwarding to Console_FMenu. Same English labels regardless of lang: these are
     // RUN-MAT's own fixed key legends (ref/TOPBAR.txt), and no French wording for them is documented
     // anywhere in this repo, so none is invented here.
-    menu = "JUMP|DEL|MAT|MATH|CAS|File";
+    // Monolith (M2 task 9): CAS->Shift+F1, File->Shift+F2, Pins->Shift+F3; label all three.
+    menu = "JUMP|DEL|MAT|MATH||";
+    shiftmenu = "CAS|File|Pins|";
+    shiftmenu += adjust(menu_f10, 6);
+    shiftmenu += "|";
+    shiftmenu += adjust(menu_f11);
+    shiftmenu += "|";
+    shiftmenu += adjust(menu_f12);
   }
   //drawRectangle(0,174,LCD_WIDTH_PX,24,COLOR_BLACK);
   int xcas_color=python_compat(contextptr)==0?65055:COLOR_CYAN,python_color=65520,js_color=63048;
