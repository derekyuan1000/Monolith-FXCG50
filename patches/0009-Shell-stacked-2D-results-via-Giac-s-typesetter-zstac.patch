From 4ffa92df11850035ecbd8945ec805b4b24ace6a1 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Fri, 25 Sep 2026 16:59:26 +0100
Subject: [PATCH 09/26] Shell: stacked (2D) results via Giac's typesetter
 (zstack), right-aligned at x=374

Console_Disp asks zstack_console_layout() for the pixel row (zly) and the
drawing mode (zlm) of each visible level. OUTPUT levels that are fractions,
powers or roots are drawn by zstack_console_draw (Equation_draw on a cached
laid-out tree); other levels keep the stock drawing code, with locate(x,i+1)
replaced by zlocate(x,zly[i]) and Cursor.y*vfontsize by zly[i]. When no
visible level is stacked, zly[i]==i*vfontsize and every level is text, so
every draw call gets the same arguments as before (text-only sessions draw
exactly as before). kdisplay.h declares the existing zdisplay.cc
Equation_draw(const gen&,...) for zstack.cc; no Giac algebra touched.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 console.cc | 27 ++++++++++++++++++++-------
 kdisplay.h |  3 +++
 2 files changed, 23 insertions(+), 7 deletions(-)

diff --git a/console.cc b/console.cc
index ac044a6..33990dd 100644
--- a/console.cc
+++ b/console.cc
@@ -5,6 +5,7 @@
 #include "zskin_angle.h"
 #include "zskin_tabs.h"
 #include "znat.h"
+#include "zstack.h"
 #include <fxcg/file.h>
 #include <fxcg/keyboard.h>
 #include <fxcg/system.h>
@@ -3146,6 +3147,12 @@ void locate(int x,int y){
 #endif
 }
 
+// Monolith: locate(x,i+1) with the row given in pixels (print_y units): identical to it when py==i*vfontsize
+static void zlocate(int x,int py){
+  locate(x,1);
+  print_y=py;
+}
+
 void Cursor_SetPosition(int x,int y){
   return locate(x+1,y+1);
 }
@@ -3363,6 +3370,9 @@ int Console_Disp(){
   int print_y_locate;
 
   Bdisp_AllClr_VRAM();
+  // Monolith: pixel row of each visible level (zly) and how it is drawn (zlm); see zstack.h.
+  int zly[LINE_DISP_MAX]; unsigned char zlm[LINE_DISP_MAX];
+  zstack_console_layout(zly,zlm);
 
   //GetFKeyIconPointer( 0x01BE, &ficon );
   //DisplayFKeyIcon( i, ficon);
@@ -3370,11 +3380,14 @@ int Console_Disp(){
   //Reading each "line" that will be printed
   for (i = 0; (i < LINE_DISP_MAX) && (i + Start_Line <= Last_Line); i++){
     console_line & curline=Line[i+Start_Line];
+    // Monolith: stacked results (zstack.cc); with nothing stacked every level is ZSTACK_TEXT and zly[i]==i*vfontsize
+    if (zlm[i]==ZSTACK_OFF) continue;
+    if (zlm[i]==ZSTACK_2D){ zstack_console_draw(i,zly[i],i==Cursor.y); continue; }
     bool colorsyntax=curline.type == LINE_TYPE_INPUT;
     if (i == Cursor.y){
       // cursor line
       if (curline.type == LINE_TYPE_INPUT || curline.type == LINE_TYPE_OUTPUT && curline.disp_len >= COL_DISP_MAX){
-	locate(1, i + 1);
+	zlocate(1, zly[i]);
 	if (curline.readonly){
 #ifdef CURSOR
 	  Cursor_SetFlashOff();
@@ -3385,7 +3398,7 @@ int Console_Disp(){
 	  Print(curline.str+curline.start_col+(Cursor.x>COL_DISP_MAX-1?1:0),TEXT_COLOR_BLACK,colorsyntax);
       }
       else {
-	locate(COL_DISP_MAX - curline.disp_len + 1, i + 1);
+	zlocate(COL_DISP_MAX - curline.disp_len + 1, zly[i]);
 	if (curline.readonly){
 #ifdef CURSOR
 	  Cursor_SetFlashOff();
@@ -3400,7 +3413,7 @@ int Console_Disp(){
 #ifdef CURSOR
 	locate(COL_DISP_MAX, i + 1);
 #else
-	print_y=i*vfontsize;
+	print_y=zly[i];
 	print_x=LCD_WIDTH_PX-hfontsize;
 #endif
 	if (curline.readonly){
@@ -3417,7 +3430,7 @@ int Console_Disp(){
       }
 
       if (curline.start_col > 0){
-	locate(1, i + 1);	
+	zlocate(1, zly[i]);	
 	if (curline.readonly){
 #ifdef CURSOR
 	  Cursor_SetFlashOff();
@@ -3431,7 +3444,7 @@ int Console_Disp(){
 
       if (!curline.readonly){
 	  int fakestart=curline.start_col+(Cursor.x > COL_DISP_MAX-1?1:0);
-	  int fakex,fakey=Cursor.y*vfontsize;
+	  int fakex,fakey=zly[i]; // i == Cursor.y
 	  string fakes;
 	  // parenthese match
 	  const char * str=(const char *) curline.str;
@@ -3515,7 +3528,7 @@ int Console_Disp(){
 	//DefineStatusMessage((giac::print_DOUBLE_(Cursor.y,6)+","+giac::print_DOUBLE_(print_y,6)).c_str(),1,0,0);
 	//DisplayStatusArea();
 	fakes=string((const char *)curline.str).substr(fakestart,Cursor.x);
-	fakex=0;fakey=Cursor.y*vfontsize;
+	fakex=0;fakey=zly[i];
 	print(fakex,fakey,fakes.c_str(),TEXT_COLOR_BLACK,false,true/* fake*/,false);
 	drawRectangle(fakex,24+fakey,2,vfontsize,COLOR_BLACK);
 	//drawRectangle(Cursor.x*hfontsize,24+Cursor.y*vfontsize,2,vfontsize,COLOR_BLACK);
@@ -3524,7 +3537,7 @@ int Console_Disp(){
     } // end cursor line
     else {
       bool bigoutput = curline.type==LINE_TYPE_OUTPUT && curline.disp_len>=COL_DISP_MAX-3;
-      locate(bigoutput?3:1,i+1);
+      zlocate(bigoutput?3:1,zly[i]);
       if (curline.type==LINE_TYPE_INPUT || bigoutput)
 	Print(curline.str + curline.start_col,TEXT_COLOR_BLACK,colorsyntax);
       else {
