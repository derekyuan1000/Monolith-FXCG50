From 0605cacb0d275a481712a149f41bde379a60e21a Mon Sep 17 00:00:00 2001
From: Derek Yuan <khicas-fork@localhost>
Date: Thu, 19 Nov 2026 23:50:26 +0000
Subject: [PATCH 24/25] One screen flip per key: Console_Disp before
 in_ckgetkey no longer flips (g_defer_flip, CONSOLE_DISP_DEFERRED)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 console.cc | 29 +++++++++++++++++------------
 1 file changed, 17 insertions(+), 12 deletions(-)

diff --git a/console.cc b/console.cc
index f3103c2..ab967c7 100644
--- a/console.cc
+++ b/console.cc
@@ -64,8 +64,11 @@ int zpinned_open(void);
 
 giac::context * contextptr=0;
 int xthetat=0,xcas_python_eval=0;
-// Monolith: set to 1 before calling Console_Disp from an overlay to suppress the premature flip.
-int g_suppress_status_flip = 0;
+// Monolith: nesting counter; while > 0, console_disp_status draws but does not flip (CONSOLE_DISP_DEFERRED, overlays).
+int g_defer_flip = 0;
+// Monolith: redraw without flipping when the next thing that runs is in_ckgetkey(waitforkey=1), which redraws the
+// status bar and flips once before it waits. One flip per key instead of two (docs/perf-baseline.md).
+#define CONSOLE_DISP_DEFERRED() do { ++g_defer_flip; Console_Disp(); --g_defer_flip; } while (0)
 extern int cpu_speed;  /* Monolith: defined in main.cc; read/set by SETUP overclock option */
 
 //const console_line data_line={0,0,0,-1,0};
@@ -2471,7 +2474,7 @@ int Console_GetKey(){
     // if (key==30006) OS_InnerWait_ms(1000); // key='6';
     if (key!=KEY_CHAR_FRAC) translate_fkey(key);
     // Monolith (M2 task 9): EXIT on the bare shell is a silent no-op (mode-switch dialog removed).
-    if (key==KEY_CTRL_EXIT) { Console_Disp(); continue; }
+    if (key==KEY_CTRL_EXIT) { CONSOLE_DISP_DEFERRED(); continue; }
     if (key==KEY_CTRL_SD || key==KEY_CTRL_FD){
       // Monolith (M2 task 6): S<->D opens a native-list-style pop-up to choose the form of the last result
       // (docs/KEY_CONFLICTS.md section 3, "S<->D" row), instead of the add-ins menu (still reachable from
@@ -2583,7 +2586,7 @@ int Console_GetKey(){
 #endif
 	}	  
       }
-      Console_Disp();
+      CONSOLE_DISP_DEFERRED();
       continue;
     }
     if (key==KEY_CTRL_F4){
@@ -2598,7 +2601,7 @@ int Console_GetKey(){
       if (!alph && Current_Line==Last_Line && !Line[Current_Line].readonly){
 	int mk=znat_math_submenu(menucolorbg);
 	if (mk==ZNAT_TPL_NONE){
-	  Console_Disp();
+	  CONSOLE_DISP_DEFERRED();
 	  continue;
 	}
 	int znr=znat_edit_template(mk);
@@ -2798,7 +2801,7 @@ int Console_GetKey(){
         }
         break;
       } // end while(1)
-      Console_Disp();
+      CONSOLE_DISP_DEFERRED();
       return CONSOLE_SUCCEEDED;
 #else
       char filename[MAX_FILENAME_SIZE+1];
@@ -2830,7 +2833,7 @@ int Console_GetKey(){
 	const char * mptr=input_matrix(false);
 	if (mptr) return Console_Input((const unsigned char *)mptr);
       }
-      Console_Disp();
+      CONSOLE_DISP_DEFERRED();
       continue;
     }
     // Monolith (M2 task 9): Shift+F1/F2/F3 open CAS sub-bar, File menu, Pinned items.
@@ -2851,7 +2854,7 @@ int Console_GetKey(){
 	  ) && Current_Line==Last_Line && !Line[Current_Line].readonly && Current_Col>0){
       // find cmdname
       console_help_insert(false);
-      Console_Disp();
+      CONSOLE_DISP_DEFERRED();
       continue;
       // keytooltip=Console_tooltip(contextptr);
     }
@@ -2921,13 +2924,13 @@ int Console_GetKey(){
 	  Console_Input(buf);
 	}
       }
-      Console_Disp();
+      CONSOLE_DISP_DEFERRED();
       continue;
     }
 
     if (key == KEY_CTRL_SETUP) {
       menu_setup();
-      Console_Disp();
+      CONSOLE_DISP_DEFERRED();
       continue;
     }
 
@@ -3470,7 +3473,7 @@ void console_disp_status(){
   // status, clock, 
   set_xcas_status();
   /* Monolith: suppressed when an overlay (fraction editor, S<->D panel, sub-bar) is drawing on top */
-  if (!g_suppress_status_flip) zflip();
+  if (!g_defer_flip) zflip();
 }  
 
 int Console_Disp(){
@@ -3791,7 +3794,9 @@ unsigned char *Console_GetLine()
   do
     {
       return_val = Console_GetKey();
-      Console_Disp();
+      // EXE (and a memory error) leave this loop, so that frame must be shown now (the input line moved to history
+      // while a long computation runs); every other key comes back to in_ckgetkey, which flips.
+      if (return_val == CONSOLE_NEW_LINE_SET || return_val == CONSOLE_MEM_ERR) Console_Disp(); else CONSOLE_DISP_DEFERRED();
       if (return_val == CONSOLE_MEM_ERR) return NULL;
     } while (return_val != CONSOLE_NEW_LINE_SET);
 
-- 
2.53.0

