From 48a4ed1a98456f526f84bc435d19249f78a74264 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Fri, 25 Sep 2026 17:11:30 +0100
Subject: [PATCH 10/26] Shell: free the stacked-result cache (zstack_release)
 at the start of do_run

No cached 2D result trees stay on the heap during a computation; they are
rebuilt for the visible levels at the next Console_Disp.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 main.cc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/main.cc b/main.cc
index e1cee56..bb06a38 100644
--- a/main.cc
+++ b/main.cc
@@ -30,6 +30,7 @@ extern "C" {
 #include <gint/kmalloc.h>
 
 #include "console.h"
+#include "zstack.h"
   //#include "memmgr.h"
 #include "catalogGUI.hpp"
 #include "fileGUI.hpp"
@@ -2371,6 +2372,7 @@ bool textedit(char * s,int bufsize,const giac::context * contextptr){
 }
 
 void do_run(const char * s,gen & g,gen & ge){
+  zstack_release(); // Monolith: no cached 2D result trees on the heap during the computation
   esc_flag=0;
   ctrl_c=false;
   kbd_interrupted=interrupted=false;
-- 
