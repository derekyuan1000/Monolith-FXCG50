From 8adae285c15f66815d3dce6fe43652d23f5f3054 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Sun, 27 Sep 2026 13:52:42 +0100
Subject: [PATCH 11/22] Shell: power/x-squared/reciprocal/sqrt/abs/n-th-root
 keys open the natural-input editor (znat_edit_template) with that template
 pre-inserted, same guard as the fraction key (M2 task 5). MATH sub-bar,
 matrix nav keys and the rest of the wiring live entirely in skin/znat.cc
 (overlaid at build time, not tracked here).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 console.cc | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/console.cc b/console.cc
index 33990dd..922500e 100644
--- a/console.cc
+++ b/console.cc
@@ -2484,6 +2484,24 @@ int Console_GetKey(){
 	}
       }
     }
+    if ((key==KEY_CHAR_POW || key==KEY_CHAR_SQUARE || key==KEY_CHAR_RECIP || key==KEY_CHAR_ROOT ||
+	 key==KEY_CHAR_VALR || key==KEY_CHAR_POWROOT) &&
+	!alph && Current_Line==Last_Line && !Line[Current_Line].readonly){
+      // Monolith (M2 task 5): power/x-squared/reciprocal/sqrt/abs/n-th-root keys open the natural-input editor
+      // (znat.cc) with that template pre-inserted, capturing the atom before the caret the same way the
+      // fraction key always has. ZNAT_NOT_HANDLED falls through to what these keys did before (keytostring
+      // text insertion further below in this function): the current behaviour is unchanged when the model
+      // cannot hold the line.
+      int tpl_kind = key==KEY_CHAR_POW ? ZNAT_TPL_POW
+	: key==KEY_CHAR_SQUARE ? ZNAT_TPL_SQUARE
+	: key==KEY_CHAR_RECIP ? ZNAT_TPL_RECIP
+	: key==KEY_CHAR_ROOT ? ZNAT_TPL_SQRT
+	: key==KEY_CHAR_VALR ? ZNAT_TPL_ABS
+	: ZNAT_TPL_NROOT;
+      int znr=znat_edit_template(tpl_kind);
+      if (znr!=ZNAT_NOT_HANDLED)
+	return znr;
+    }
     if (key==KEY_CHAR_FRAC && !alph && Current_Line==Last_Line && !Line[Current_Line].readonly){
       // Monolith: natural-input fraction editor (znat.cc); ZNAT_NOT_HANDLED falls through to the stock eqws editor
       int znr=znat_edit();
-- 
