From afae199e92d9fbefe6d759ce03620c26bc575857 Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Sun, 27 Sep 2026 18:00:00 +0100
Subject: [PATCH 14/21] Shell: task 7 review fixes (EXIT in the F4 MATH bar
 returns to the shell, alpha-F1..F3 keep their old path, right-aligned text
 never starts left of x=0)

Hand-written in a session without the fork tree (the toolchain host was
unreachable); applies on top of 0013. Re-export with tools/export_patches.sh
after the next real build to get git's own header and index lines.
---
 console.cc | 25 ++++++++++++++++---------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/console.cc b/console.cc
index a11aaab..f05e041 100644
--- a/console.cc
+++ b/console.cc
@@ -2563,15 +2563,18 @@ int Console_GetKey(){
       // the bare shell line"), same guard every template key already uses (Current_Line==Last_Line: the
       // line being edited; !readonly; !alph: alpha-F4 keeps the plain catalog below, matching how alpha
       // never opens the natural editor for the physical template keys either). ZNAT_TPL_NONE (EXIT with no
-      // pick) or ZNAT_NOT_HANDLED (the template did not fit, or the line does not fit the nin/ model) falls
-      // through to the catalog exactly as F4 always behaved, unchanged.
+      // pick) returns to the shell like any native sub-bar (task 7 review fix: it used to open the catalog);
+      // ZNAT_NOT_HANDLED (the template did not fit, or the line does not fit the nin/ model) falls through to
+      // the catalog, as F4 always behaved.
       if (!alph && Current_Line==Last_Line && !Line[Current_Line].readonly){
 	int mk=znat_math_submenu(menucolorbg);
-	if (mk!=ZNAT_TPL_NONE){
-	  int znr=znat_edit_template(mk);
-	  if (znr!=ZNAT_NOT_HANDLED)
-	    return znr;
+	if (mk==ZNAT_TPL_NONE){
+	  Console_Disp();
+	  continue;
 	}
+	int znr=znat_edit_template(mk);
+	if (znr!=ZNAT_NOT_HANDLED)
+	  return znr;
       }
       char buf[512];
       if (!showCatalog(buf,0,0))
@@ -2777,17 +2780,19 @@ int Console_GetKey(){
       return CONSOLE_SUCCEEDED;
 #endif
     }
-    if (key==KEY_CTRL_F1){
+    // Monolith (M2 task 7 review): the three native homes below are bare F1/F2/F3 only; with alpha on they keep
+    // their old path further down (the alpha legend still shows those old entries), as F4 does.
+    if (key==KEY_CTRL_F1 && !alph){
       // Monolith (M2 task 7): F1 JUMP (docs/KEY_CONFLICTS.md section 2), replacing the old menu_f1 fast
       // menu here (moved into the new F5 CAS sub-bar below, unchanged). skin/zshellbar.cc zjump_open.
       return zjump_open();
     }
-    if (key==KEY_CTRL_F2){
+    if (key==KEY_CTRL_F2 && !alph){
       // Monolith (M2 task 7): F2 DELETE (DEL-LINE / DEL-ALL), replacing the old menu_f2 fast menu here
       // (moved into the CAS sub-bar). skin/zshellbar.cc zdelete_open.
       return zdelete_open();
     }
-    if (key==KEY_CTRL_F3){
+    if (key==KEY_CTRL_F3 && !alph){
       // Monolith (M2 task 7): F3 opens the existing KhiCAS matrix editor directly (the same call the F6
       // Applications menu's own "Matrix editor" entry makes below), replacing the old menu_f3 fast menu
       // here (moved into the CAS sub-bar).
@@ -3466,6 +3471,7 @@ int Console_Disp(){
       else {
 	zlocate(COL_DISP_MAX - curline.disp_len + 1, zly[i]);
 	print_x -= (LCD_WIDTH_PX - 1 - RM_RESULT_RIGHT_X);  // Monolith M2 task 7: leave the scrollbar gutter free
+	if (print_x<0) print_x=0;  // task 7 review: a full-width line keeps its first column on screen
 	if (curline.readonly){
 #ifdef CURSOR
 	  Cursor_SetFlashOff();
@@ -3613,6 +3619,7 @@ int Console_Disp(){
 #else
 	print(print_x,print_y,(const char *)curline.str,TEXT_COLOR_BLACK,false,true/*fake*/,false);
 	print_x=LCD_WIDTH_PX-print_x-(LCD_WIDTH_PX - 1 - RM_RESULT_RIGHT_X);  // Monolith M2 task 7
+	if (print_x<0) print_x=0;  // task 7 review: same clamp as above
 #endif
 	Print(curline.str,TEXT_COLOR_BLACK,colorsyntax);
       }
-- 
