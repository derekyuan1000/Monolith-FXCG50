From df5c8942db8e508aef52b0788651ec0af5863ecb Mon Sep 17 00:00:00 2001
From: khicas-fork <khicas-fork@localhost>
Date: Thu, 24 Sep 2026 20:52:28 +0100
Subject: [PATCH 07/22] Tab labels drawn in the interpreter colour
 (skin_tabs_fg(menucolorbg))

The old menu-band background colour showed the active interpreter; the tab bar
now keeps black tabs and draws the labels in that colour (white when unset or
too dark to read).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 console.cc | 2 +-
 main.cc    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/console.cc b/console.cc
index 6c9d375..b97232f 100644
--- a/console.cc
+++ b/console.cc
@@ -3341,7 +3341,7 @@ void console_disp_status(){
   int px=0*3,py=58*3;
   char labels[SKIN_TABS][SKIN_TAB_LABEL_MAX];
   skin_tabs_split(menu.c_str(),labels);
-  skin_tabs_draw(labels);
+  skin_tabs_draw(labels,skin_tabs_fg(menucolorbg));
   // status, clock, 
   set_xcas_status();
   Bdisp_PutDisp_DD();
diff --git a/main.cc b/main.cc
index 3aa06ab..e1cee56 100644
--- a/main.cc
+++ b/main.cc
@@ -749,7 +749,7 @@ void casiostatus(const char * menu,const char * shiftmenu,const char * alphamenu
       prev=cur;
       char labels[SKIN_TABS][SKIN_TAB_LABEL_MAX];
       skin_tabs_split(cur,labels);
-      skin_tabs_draw(labels);
+      skin_tabs_draw(labels,skin_tabs_fg(color));
     }
   }
 }
